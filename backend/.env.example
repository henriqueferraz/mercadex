# Banco de dados (Neon DB — PostgreSQL serverless)
# Obtenha sua connection string em https://console.neon.tech
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require&channel_binding=require"

# JWT
JWT_SECRET="troque-por-uma-string-aleatoria-longa"
JWT_REFRESH_SECRET="troque-por-outra-string-aleatoria-longa"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Servidor
PORT=3001
NODE_ENV=development
